# MySQL local development values. Replace them outside local development.
MYSQL_DATABASE=zeropay_lunch
MYSQL_USER=zeropay
MYSQL_PASSWORD=zeropay_local
MYSQL_ROOT_PASSWORD=root_local

# Ports published only on 127.0.0.1 by Docker Compose.
MYSQL_PORT=3306
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
AI_PORT=8001
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring Boot -> FastAPI policy. The HTTP client is added with FastAPI integration.
AI_BASE_URL=http://ai:8001
AI_CONNECT_TIMEOUT=2s
AI_RESPONSE_TIMEOUT=8s
AI_MAX_ATTEMPTS=1
AI_FALLBACK_ENABLED=true

# Internal service URLs are defined by docker-compose.yml and are not browser-facing.
# LLM and embedding provider variables will be added only when those integrations exist.
