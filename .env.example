# Harness Role: 필요한 환경변수 이름과 안전한 로컬 예시를 공개하는 계약이다.
# Agent Usage: setup, Docker 또는 profile 설정을 바꿀 때 실제 소비 변수와 함께 확인한다.
# Why: 실제 비밀을 커밋하거나 문서에 없는 개인 환경값에 의존하는 것을 방지한다.
# Connection: .gitignore가 실제 .env를 제외하고, setup.sh와 docker-compose.yml이 이 계약을 사용한다.

# MySQL local development values. Replace them outside local development.
MYSQL_DATABASE=zeropay_lunch
MYSQL_USER=zeropay
MYSQL_PASSWORD=zeropay_local
MYSQL_ROOT_PASSWORD=root_local

# Ports published only on 127.0.0.1 by Docker Compose.
MYSQL_PORT=3306
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
AI_PORT=8001
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring Boot -> FastAPI policy. Compose reads these values, but the HTTP client is not implemented yet.
AI_BASE_URL=http://ai:8001
AI_CONNECT_TIMEOUT=2s
AI_RESPONSE_TIMEOUT=8s
AI_MAX_ATTEMPTS=1
AI_FALLBACK_ENABLED=true

# Internal service URLs are defined by docker-compose.yml and are not browser-facing.
# LLM and embedding provider variables will be added only when those integrations exist.
